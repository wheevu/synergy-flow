# ──────────────────────────────────────────────
# SynergyFlow — Required Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=synergyflow
POSTGRES_USER=synergy
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://synergy:change-me@postgres:5432/synergyflow?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-32-plus-random-bytes

# Public URL of the frontend (used for CORS, invite links, and redirects)
# For local dev: http://localhost:55173
# For production: https://app.yourdomain.com
FRONTEND_URL=https://app.example.com

# Frontend API base URL (Vite build-time env, not a production runtime setting).
# docker-compose.prod.yml uses same-origin /api routing unless the frontend image build is changed.
# For same-origin deployment (frontend + API behind same Nginx):
#   leave empty or set to "" — the frontend will use relative /api paths.
# For local dev without Docker Compose:
#   http://localhost:8080/api
# For production with separate API domain:
#   https://api.yourdomain.com
VITE_API_URL=

# Backend listen port (default 8080)
PORT=8080

# AWS S3 (production) or MinIO (local dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=synergyflow-prod
# Leave S3_ENDPOINT empty for standard AWS S3.
# For MinIO local dev: http://minio:9000
# For S3-compatible alternatives: https://s3.custom-endpoint.com
S3_ENDPOINT=

# Email jobs are queued and logged by the worker. RESEND_API_KEY is reserved
# for future transactional email support; the backend does not call Resend yet.
RESEND_API_KEY=
FROM_EMAIL=SynergyFlow <noreply@example.com>

# Durable SSE replay event log
EVENTLOG_ROOT=/var/lib/synergyflow/eventlog
EVENTLOG_FSYNC=false

# ──────────────────────────────────────────────
# Local development port mappings
# These are only used by docker-compose.yml (not the production variant).
# Chosen to avoid conflicts with local Postgres/Redis/MinIO services.
# ──────────────────────────────────────────────
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
BACKEND_PORT=8080
FRONTEND_PUBLIC_URL=http://localhost:55173
FRONTEND_PORT=55173
